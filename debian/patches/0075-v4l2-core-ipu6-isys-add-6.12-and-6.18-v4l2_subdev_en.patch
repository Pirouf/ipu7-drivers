++	 */
++	buffer_set->ipu_virtual_address = 0;
++	buffer_set->process_group_handle = kcmd->kpg->pg->ipu_virtual_address;
++	buffer_set->frame_counter = frame_counter;
++	buffer_set->terminal_count = kcmd->kpg->pg->terminal_count;
++
++	/*
