++		kpg = kzalloc(sizeof(*kpg), GFP_KERNEL);
++		if (!kpg)
++			goto out_free_pgs;
++		kpg->pg = ipu6_dma_alloc(adev, IPU_PSYS_PG_MAX_SIZE,
++					 &kpg->pg_dma_addr,
++					 GFP_KERNEL, 0);
++		if (!kpg->pg) {
++			kfree(kpg);
++			goto out_free_pgs;
++		}
++		kpg->size = IPU_PSYS_PG_MAX_SIZE;
++		list_add(&kpg->list, &psys->pgs);
++	}
++
++	psys->caps.pg_count = ipu6_cpd_pkg_dir_get_num_entries(adev->pkg_dir);
