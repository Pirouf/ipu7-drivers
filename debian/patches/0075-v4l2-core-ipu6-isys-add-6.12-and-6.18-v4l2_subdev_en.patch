++
++	kppg = ipu_psys_identify_kppg(kcmd);
++	sched = &kcmd->fh->sched;
++
++	if (kcmd->kbuf_set) {
++		mutex_lock(&sched->bs_mutex);
++		kcmd->kbuf_set->buf_set_size = 0;
++		mutex_unlock(&sched->bs_mutex);
++		kcmd->kbuf_set = NULL;
