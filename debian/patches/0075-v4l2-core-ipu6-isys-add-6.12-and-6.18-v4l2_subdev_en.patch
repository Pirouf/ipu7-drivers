++static int ipu_resource_init(struct ipu_resource *res, u32 id, int elements)
++{
++	if (elements <= 0) {
++		res->bitmap = NULL;
++		return 0;
++	}
++
++	res->bitmap = bitmap_zalloc(elements, GFP_KERNEL);
++	if (!res->bitmap)
++		return -ENOMEM;
++	res->elements = elements;
++	res->id = id;
++	return 0;
++}
