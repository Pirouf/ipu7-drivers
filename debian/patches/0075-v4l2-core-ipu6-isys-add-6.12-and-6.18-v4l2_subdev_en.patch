diff --git a/6.17.0/include-overrides/media/ipu-bridge.h b/6.17.0/include-overrides/media/ipu-bridge.h
index 16fac7654..f8642d099 100644
--- a/6.17.0/include-overrides/media/ipu-bridge.h
+++ b/6.17.0/include-overrides/media/ipu-bridge.h
@@ -91,7 +91,9 @@ struct ipu_sensor_ssdb {
 	u8 controllogicid;
 	u8 reserved1[3];
 	u8 mclkport;
-	u8 reserved2[13];
