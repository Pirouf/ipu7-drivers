++int ipu_fw_psys_pg_disown(struct ipu_psys_kcmd *kcmd)
++{
++	struct ipu_fw_psys_cmd *psys_cmd;
++	struct device *dev = &kcmd->fh->psys->adev->auxdev.dev;
++	int ret = 0;
++
++	psys_cmd = ipu6_send_get_token(kcmd->fh->psys->fwcom, 0);
