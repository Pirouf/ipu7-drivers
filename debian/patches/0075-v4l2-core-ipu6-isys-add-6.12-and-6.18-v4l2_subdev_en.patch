++				  run_fw_init_work);
++		fw_init_task.psys = psys;
++		schedule_delayed_work((struct delayed_work *)&fw_init_task, 0);
++	} else {
++		rval = ipu_psys_fw_init(psys);
++	}
++
++	if (rval) {
++		dev_err(dev, "FW init failed(%d)\n", rval);
++		goto out_free_pgs;
++	}
