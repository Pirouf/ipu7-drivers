+	struct v4l2_rect        w;
+	__u32			field;	/* enum v4l2_field */
+	__u32			chromakey;
+	compat_caddr_t		clips; /* always NULL */
+	__u32			clipcount; /* always 0 */
+	compat_caddr_t		bitmap; /* always NULL */
+	__u8                    global_alpha;
+};
