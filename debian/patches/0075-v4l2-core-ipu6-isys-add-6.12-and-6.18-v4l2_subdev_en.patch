++
++	val |= IPU6_PSYS_SPC_STATUS_START |
++	    IPU6_PSYS_SPC_STATUS_RUN |
++	    IPU6_PSYS_SPC_STATUS_CTRL_ICACHE_INVALIDATE;
++	val |= psys->icache_prefetch_sp ?
++	    IPU6_PSYS_SPC_STATUS_ICACHE_PREFETCH : 0;
