diff --git a/patches/0056-media-ipu-Dma-sync-at-buffer_prepare-callback-as-DMA.patch b/patches/0056-media-ipu-Dma-sync-at-buffer_prepare-callback-as-DMA.patch
new file mode 100644
index 000000000..8b66f0e48
--- /dev/null
+++ b/patches/0056-media-ipu-Dma-sync-at-buffer_prepare-callback-as-DMA.patch
