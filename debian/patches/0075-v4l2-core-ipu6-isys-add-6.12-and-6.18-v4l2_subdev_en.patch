++	if (ret)
++		goto error;
++
++	kcmd->pg_manifest_size = cmd->pg_manifest_size;
++
++	kcmd->user_token = cmd->user_token;
++	kcmd->issue_id = cmd->issue_id;
++	kcmd->priority = cmd->priority;
++	if (kcmd->priority >= IPU_PSYS_CMD_PRIORITY_NUM)
