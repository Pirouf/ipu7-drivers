++	struct ipu6_device *isp = pci_get_drvdata(pdev);
++	struct ipu6_bus_device *adev = isp->psys;
++
++	ipu6_dma_unmap_sgtable(adev, sgt, dir, DMA_ATTR_SKIP_CPU_SYNC);
++	dma_unmap_sgtable(&pdev->dev, sgt, dir, 0);
++}
