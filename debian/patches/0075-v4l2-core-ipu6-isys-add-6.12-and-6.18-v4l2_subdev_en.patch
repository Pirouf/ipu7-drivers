++static void ipu_psys_put_userpages(struct ipu_dma_buf_attach *attach)
++{
++	if (!attach || !attach->userptr || !attach->sgt)
++		return;
++
++	unpin_user_pages(attach->pages, attach->npages);
++	kvfree(attach->pages);
++
++	sg_free_table(attach->sgt);
++	kfree(attach->sgt);
++	attach->sgt = NULL;
++}
