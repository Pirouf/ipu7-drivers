++
++	if (n <= 0) {
++		alloc->elements = 0;
++		return 0;
++	}
++
++	if (!res->bitmap)
++		return (unsigned long)(-ENOSPC);
++
++	p = bitmap_find_next_zero_area(res->bitmap, res->elements, 0, n, 0);
++	alloc->resource = NULL;
++
++	if (p >= res->elements)
++		return (unsigned long)(-ENOSPC);
++	bitmap_set(res->bitmap, p, n);
++	alloc->resource = res;
++	alloc->elements = n;
++	alloc->pos = p;
++	alloc->type = type;
++
++	return p;
++}
