++{
++	compat_uptr_t ptr = (u32)((unsigned long)kp->manifest);
++	bool access_ok;
++
++	access_ok = access_ok(up, sizeof(struct ipu_psys_manifest32));
++	if (!access_ok || put_user(kp->index, &up->index) ||
