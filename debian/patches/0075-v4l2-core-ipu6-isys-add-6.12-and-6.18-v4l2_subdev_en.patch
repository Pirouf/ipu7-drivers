++static struct ipu_psys_ppg *ipu_psys_identify_kppg(struct ipu_psys_kcmd *kcmd)
++{
++	struct ipu_psys_scheduler *sched = &kcmd->fh->sched;
++	struct ipu_psys_ppg *kppg, *tmp;
++
++	mutex_lock(&kcmd->fh->mutex);
++	if (list_empty(&sched->ppgs))
