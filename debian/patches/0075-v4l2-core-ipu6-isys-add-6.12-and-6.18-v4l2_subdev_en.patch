++			mutex_lock(&kppg->mutex);
++			if (!list_empty(&kppg->kcmds_new_list) ||
++			    !list_empty(&kppg->kcmds_processing_list)) {
++				mutex_unlock(&kppg->mutex);
++				mutex_unlock(&fh->mutex);
++				return true;
++			}
++			mutex_unlock(&kppg->mutex);
++		}
++		mutex_unlock(&fh->mutex);
++	}
++
++	return false;
++}
