++		if (!(val & BIT(31))) {
++			dev_dbg(dev, "PS sub-domains req done with status 0x%x",
++				val);
++			break;
++		}
++		i++;
++	} while (i < PSYS_SUBDOMAINS_STATUS_WAIT_COUNT);
++
++	if (i == PSYS_SUBDOMAINS_STATUS_WAIT_COUNT)
++		dev_warn(dev, "Psys sub-domains %s req timeout!",
++			 on ? "UP" : "DOWN");
++}
