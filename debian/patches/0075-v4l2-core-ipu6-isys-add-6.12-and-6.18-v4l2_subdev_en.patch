++
++	list_for_each_entry_safe(kppg, tmp, &sched->ppgs, list) {
++		if (ipu_fw_psys_pg_get_token(kcmd)
++		    != kppg->token)
++			continue;
++		mutex_unlock(&kcmd->fh->mutex);
++		return kppg;
++	}
++
++not_found:
++	mutex_unlock(&kcmd->fh->mutex);
++	return NULL;
++}
