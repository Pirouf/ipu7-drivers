+struct v4l2_subdev_fh {
+	struct v4l2_fh vfh;
+	struct module *owner;
+#if defined(CONFIG_VIDEO_V4L2_SUBDEV_API)
+	struct v4l2_subdev_state *state;
+	u64 client_caps;
+#endif
+};
+
+/**
+ * to_v4l2_subdev_fh - Returns a &struct v4l2_subdev_fh from
