++		dma_buf_unmap_attachment_unlocked(kbuf->db_attach, kbuf->sgt,
++						  DMA_BIDIRECTIONAL);
++	}
++	dma_buf_detach(kbuf->dbuf, kbuf->db_attach);
++attach_fail:
++	ipu_buffer_del(fh, kbuf);
++	dbuf = ERR_PTR(-EINVAL);
++	if (!kbuf->userptr)
++		kfree(kbuf);
++
++buf_alloc_fail:
++	ipu_desc_del(fh, desc);
++	kfree(desc);
++
++desc_alloc_fail:
++	if (!IS_ERR(dbuf))
++		dma_buf_put(dbuf);
++	return NULL;
