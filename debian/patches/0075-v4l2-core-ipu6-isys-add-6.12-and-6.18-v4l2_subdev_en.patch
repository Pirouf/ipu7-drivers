+Signed-off-by: hepengpx <pengpengx.he@intel.com>
+---
+ .../drivers/media/pci/intel/ipu6/ipu6-trace.c |  6 +++
+ .../drivers/media/pci/intel/ipu6/ipu6-trace.h |  1 +
+ .../media/pci/intel/ipu6/psys/ipu-psys.c      | 44 ++++++++++++++++++-
+ 3 files changed, 50 insertions(+), 1 deletion(-)
+
+diff --git a/6.18.0/drivers/media/pci/intel/ipu6/ipu6-trace.c b/6.18.0/drivers/media/pci/intel/ipu6/ipu6-trace.c
