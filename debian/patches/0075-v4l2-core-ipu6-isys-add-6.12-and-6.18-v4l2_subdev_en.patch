++static const struct file_operations ipu_wptraceconf_fops = {
++	.owner = THIS_MODULE,
++	.open = wptraceconf_open,
++	.release = wptraceconf_release,
++	.read = wptraceconf_read,
++	.write = wptraceconf_write,
++	.llseek = noop_llseek,
++};
