++	void __iomem *spc_regs_base = psys->pdata->base +
++	    psys->pdata->ipdata->hw_variant.spc_offset;
++	u32 val = readl(spc_regs_base + IPU6_PSYS_REG_SPC_STATUS_CTRL);
