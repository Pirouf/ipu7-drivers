++		ret = -ENODATA;
++		goto out;
++	}
++	psys_cmd->command = IPU_FW_PSYS_PROCESS_GROUP_CMD_START;
++	psys_cmd->msg = 0;
++	psys_cmd->context_handle = kcmd->kpg->pg->ipu_virtual_address;
++	ipu6_send_put_token(kcmd->fh->psys->fwcom, 0);
++
++out:
++	return ret;
++}
