++				  sizeof(struct ipu_trace), GFP_KERNEL);
++	if (!isp->trace)
++		return -ENOMEM;
++
++	mutex_init(&isp->trace->lock);
++
++	dev_dbg(&isp->pdev->dev, "ipu trace enabled!");
++
++	return 0;
++}
++
++void ipu_trace_release(struct ipu6_device *isp)
++{
++	if (!isp->trace)
++		return;
++	mutex_destroy(&isp->trace->lock);
++}
