++
++	psys_cmd->command = IPU_FW_PSYS_PROCESS_GROUP_CMD_RUN;
++	psys_cmd->msg = 0;
++	psys_cmd->context_handle = kcmd->kbuf_set->buf_set->ipu_virtual_address;
++
++	ipu6_send_put_token(kcmd->fh->psys->fwcom, queue_id);
