++
++	ret = ipu_psys_kcmd_send_to_ppg(kcmd);
++	if (ret)
++		goto error;
++
++	dev_dbg(dev, "IOC_QCMD: user_token:%llx issue_id:0x%llx pri:%d\n",
++		cmd->user_token, cmd->issue_id, cmd->priority);
++
++	return 0;
++
++error:
++	ipu_psys_kcmd_free(kcmd);
++
++	return ret;
++}
