++static int ipu6_psys_gpc_global_enable_get(void *data, u64 *val)
++{
++	struct ipu_psys_gpcs *psys_gpcs = data;
++	struct ipu_psys *psys = psys_gpcs->prit;
++
++	mutex_lock(&psys->mutex);
