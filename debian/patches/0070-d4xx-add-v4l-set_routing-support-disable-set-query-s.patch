+	dev_dbg(sensor->sd.dev, "%s(): enable: name=%s pad=%u streams_mask=%llu\n",
+		__func__, sensor->sd.name, pad, streams_mask);
+
+	return 0;
+
+}
+static int ds5_sensor_disable_streams(struct v4l2_subdev *sd,
