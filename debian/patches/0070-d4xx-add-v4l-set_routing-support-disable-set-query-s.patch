+		which == V4L2_SUBDEV_FORMAT_TRY ? "V4L2_SUBDEV_FORMAT_TRY" : "V4L2_SUBDEV_FORMAT_ACTIVE" );
+
+	_ds5_mux_set_routing(sd, v4l2_state, routing);
+
+	return 0;
+}
