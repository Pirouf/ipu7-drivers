+#define TRY(err, expr) \
+	do {\
+		err = expr; \
+		if (err) { \
+			return err; \
+		} \
+	} while (0)
+
+#define TRY_DEV_HERE(err, expr, dev) \
+	do { \
+		err = expr; \
+		if (err) { \
+			dev_err((dev), \
+				"%s failed (%d) in %s() at %s:%d", #expr, \
+				(err), __func__, __FILE__, __LINE__); \
+			return err; \
+		} \
+	} while (0)
