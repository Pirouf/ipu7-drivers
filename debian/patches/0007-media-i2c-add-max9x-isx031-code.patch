+	int rval = 0;
+
+	switch (dev_id) {
+	case MAX9296:
+		rval = max9296_get_ops(common_ops, serial_ops, csi_ops, lf_ops, trans_ops);
+		break;
+	case MAX96724:
+		rval = max96724_get_ops(common_ops, serial_ops, csi_ops, lf_ops, trans_ops);
