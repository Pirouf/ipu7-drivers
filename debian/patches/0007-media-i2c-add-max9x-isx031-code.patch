+static u8 ti960_get_nubmer_of_streaming(struct ti960 *va, u8 port)
+{
+	u8 n = 0;
+	u8 i = 0;
+	mutex_lock(&va->mutex);
+	for (; i < ARRAY_SIZE(ti960_set_sub_stream[port]); i++) {
