 	char *dev_name = devm_kzalloc(dev, I2C_NAME_SIZE, GFP_KERNEL);
+	if (!dev_name) {
+		dev_err(dev, "sensor i2c dev name alloc failed");
+		goto err_pdata;
+	}
 
