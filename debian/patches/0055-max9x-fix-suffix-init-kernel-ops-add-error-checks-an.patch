+
+	struct max9x_subdev_pdata *sdev = &ser_pdata->subdevs[0];
+	pdata_sensor(dev, sdev, sensor_name, phys_addr, virt_addr);
+
+	struct sensor_platform_data *sen_pdata = devm_kzalloc(dev, sizeof(*sen_pdata), GFP_KERNEL);
