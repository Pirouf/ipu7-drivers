From: florent pirou <florent.pirou@intel.com>
Date: Tue, 7 Oct 2025 08:49:16 -0700
Subject: [PATCH 54/71] dkms: build ipu7 exclusively linux 6.14 and 6.17

Signed-off-by: florent pirou <florent.pirou@intel.com>
---
 dkms.conf | 1 +
 1 file changed, 1 insertion(+)

diff --git a/dkms.conf b/dkms.conf
index 5cd6b3abd..89314f17b 100644
--- a/dkms.conf
+++ b/dkms.conf
@@ -1,5 +1,6 @@
 PACKAGE_NAME="ipu7-drivers"
 PACKAGE_VERSION="#MODULE_VERSION#"
+BUILD_EXCLUSIVE_KERNEL="^(6\.(1[47])\.)"
 
 MAKE="make V=1 KERNELRELEASE=$kernelver KERNEL_SRC=$kernel_source_dir"
 CLEAN="make V=1 KERNELRELEASE=$kernelver KERNEL_SRC=$kernel_source_dir clean"
