+BUILT_MODULE_LOCATION[$i]="drivers/media/pci/intel/ipu7"
+DEST_MODULE_LOCATION[$i]="/updates"
+STRIP[$i]=no
+
+BUILT_MODULE_NAME[$((++i))]="intel-ipu7-psys"
+BUILT_MODULE_LOCATION[$i]="drivers/media/pci/intel/ipu7/psys"
+DEST_MODULE_LOCATION[$i]="/updates"
+STRIP[$i]=no
