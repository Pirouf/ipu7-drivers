 #include <asm/unaligned.h>
+#else
+#include <linux/unaligned.h>
+#endif
 #include <linux/acpi.h>
 #include <linux/clk.h>
 #include <linux/delay.h>
@@ -9,7 +14,6 @@
 #include <linux/i2c.h>
 #include <linux/module.h>
