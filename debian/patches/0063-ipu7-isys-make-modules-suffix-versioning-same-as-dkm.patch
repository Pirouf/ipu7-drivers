From aa58cdf76d68b867b65357f89da09c3f86fb8a70 Mon Sep 17 00:00:00 2001
From: florent pirou <florent.pirou@intel.com>
Date: Fri, 19 Dec 2025 03:55:48 -0700
Subject: [PATCH 63/71] ipu7-isys: make modules suffix versioning same as dkms

Signed-off-by: florent pirou <florent.pirou@intel.com>
---
 Makefile                                     | 2 ++
 drivers/media/i2c/Makefile                   | 6 +++++-
 drivers/media/pci/intel/ipu7/ipu7-isys.c     | 1 +
 drivers/media/pci/intel/ipu7/ipu7.c          | 1 +
 drivers/media/pci/intel/ipu7/psys/ipu-psys.c | 1 +
 5 files changed, 10 insertions(+), 1 deletion(-)

diff --git a/Makefile b/Makefile
index 17b5089d6..1ecf15466 100644
--- a/Makefile
+++ b/Makefile
@@ -8,6 +8,8 @@ BUILD_EXCLUSIVE_KERNEL="^(6\.(1[1247])\.)"
 
 MODSRC := $(shell pwd)
 
+subdir-ccflags-y += -DDRIVER_VERSION_SUFFIX=\"${DRIVER_VERSION_SUFFIX}\"
+
 export EXTERNAL_BUILD = 1
 export CONFIG_VIDEO_INTEL_IPU7 = m
 export CONFIG_VIDEO_INTEL_IPU6 = m
diff --git a/drivers/media/i2c/Makefile b/drivers/media/i2c/Makefile
index 241c6e0f8..ba36adf28 100644
--- a/drivers/media/i2c/Makefile
+++ b/drivers/media/i2c/Makefile
@@ -12,7 +12,11 @@ ccflags-y += -I$(srcpath)/$(src)/../../../include/
 ccflags-y += -I$(srcpath)/$(src)/../../../drivers/media/pci/intel/ipu7
 
 ifeq ($(CONFIG_VIDEO_INTEL_IPU7), m)
-	ccflags-y += -DCONFIG_VIDEO_INTEL_IPU7=1
+	ccflags-y += -DCONFIG_VIDEO_INTEL_IPU7=1 -DCONFIG_VIDEO_MAX9X
+endif
+
+ifeq ($(CONFIG_VIDEO_INTEL_IPU6), m)
+	ccflags-y += -DCONFIG_VIDEO_INTEL_IPU6=1
 endif
 
 ifeq ($(CONFIG_VIDEO_D4XX), m)
diff --git a/drivers/media/pci/intel/ipu7/ipu7-isys.c b/drivers/media/pci/intel/ipu7/ipu7-isys.c
index ed3e37b57..59048fb72 100644
--- a/drivers/media/pci/intel/ipu7/ipu7-isys.c
+++ b/drivers/media/pci/intel/ipu7/ipu7-isys.c
@@ -1627,3 +1627,4 @@ MODULE_IMPORT_NS("INTEL_IPU_BRIDGE");
 MODULE_IMPORT_NS(INTEL_IPU7);
 MODULE_IMPORT_NS(INTEL_IPU_BRIDGE);
 #endif
+MODULE_VERSION(DRIVER_VERSION_SUFFIX);
diff --git a/drivers/media/pci/intel/ipu7/ipu7.c b/drivers/media/pci/intel/ipu7/ipu7.c
index 20c88d5a9..1714eb536 100644
--- a/drivers/media/pci/intel/ipu7/ipu7.c
+++ b/drivers/media/pci/intel/ipu7/ipu7.c
@@ -2891,3 +2891,4 @@ MODULE_AUTHOR("Qingwu Zhang <qingwu.zhang@intel.com>");
 MODULE_AUTHOR("Intel");
 MODULE_LICENSE("GPL");
 MODULE_DESCRIPTION("Intel ipu7 pci driver");
+MODULE_VERSION(DRIVER_VERSION_SUFFIX);
diff --git a/drivers/media/pci/intel/ipu7/psys/ipu-psys.c b/drivers/media/pci/intel/ipu7/psys/ipu-psys.c
index b20e238fa..cc0de0ffa 100644
--- a/drivers/media/pci/intel/ipu7/psys/ipu-psys.c
+++ b/drivers/media/pci/intel/ipu7/psys/ipu-psys.c
@@ -1548,3 +1548,4 @@ MODULE_IMPORT_NS("DMA_BUF");
 MODULE_IMPORT_NS(INTEL_IPU7);
 MODULE_IMPORT_NS(DMA_BUF);
 #endif
+MODULE_VERSION(DRIVER_VERSION_SUFFIX);
-- 
2.25.1

