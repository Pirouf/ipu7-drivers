+ 				ipu6-bus.o \
+ 				ipu6-dma.o \
+diff --git a/6.17.0/drivers/media/pci/intel/ipu6/ipu6-isys.c b/6.17.0/drivers/media/pci/intel/ipu6/ipu6-isys.c
