++++ b/6.17.0/drivers/media/pci/intel/ipu6/ipu6.c
+@@ -844,3 +844,4 @@ MODULE_AUTHOR("Yunliang Ding <yunliang.ding@intel.com>");
+ MODULE_AUTHOR("Hongju Wang <hongju.wang@intel.com>");
+ MODULE_LICENSE("GPL");
+ MODULE_DESCRIPTION("Intel IPU6 PCI driver");
++MODULE_VERSION(DRIVER_VERSION_SUFFIX);
