diff --git a/patches/0003-ipu6-dkms-add-isys-makefile-adaptation-6.17.patch b/patches/0003-ipu6-dkms-add-isys-makefile-adaptation-6.17.patch
new file mode 100644
index 000000000..31f9366eb
--- /dev/null
+++ b/patches/0003-ipu6-dkms-add-isys-makefile-adaptation-6.17.patch
