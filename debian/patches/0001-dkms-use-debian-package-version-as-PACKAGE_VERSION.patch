From: You-Sheng Yang <vicamo.yang@canonical.com>
Date: Tue, 9 Jul 2024 22:55:51 +0800
Subject: dkms: use debian package version as PACKAGE_VERSION

Signed-off-by: You-Sheng Yang <vicamo.yang@canonical.com>
---
 dkms.conf | 4 ++--
 1 file changed, 2 insertions(+), 2 deletions(-)

diff --git a/dkms.conf b/dkms.conf
index 702f3e0..adb5d7a 100644
--- a/dkms.conf
+++ b/dkms.conf
@@ -1,5 +1,5 @@
-PACKAGE_NAME=ipu7-drivers
-PACKAGE_VERSION=0.0.0
+PACKAGE_NAME="ipu7-drivers"
+PACKAGE_VERSION="#MODULE_VERSION#"
 
 MAKE="make KERNELRELEASE=$kernelver KERNEL_SRC=$kernel_source_dir"
 CLEAN="make KERNELRELEASE=$kernelver KERNEL_SRC=$kernel_source_dir clean"
