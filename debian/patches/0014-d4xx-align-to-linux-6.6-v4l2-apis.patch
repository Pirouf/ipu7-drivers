From 99694e7d3fab5d2bca52260b6ceefe9067b49992 Mon Sep 17 00:00:00 2001
From: zouxiaoh <xiaohong.zou@intel.com>
Date: Thu, 21 Mar 2024 17:05:22 +0800
Subject: [PATCH 14/62] d4xx : align to linux 6.6 v4l2 apis

* Kernel 6.6.15 release for Ubuntu (#216)

Signed-off-by: zouxiaoh <xiaohong.zou@intel.com>
Signed-off-by: florent pirou <florent.pirou@intel.com>
---
 drivers/media/i2c/d4xx.c    |  8 +++++++-
 drivers/media/i2c/max9295.c | 10 ++++++++++
 drivers/media/i2c/max9296.c | 10 ++++++++++
 3 files changed, 27 insertions(+), 1 deletion(-)

diff --git a/drivers/media/i2c/d4xx.c b/drivers/media/i2c/d4xx.c
index 06ce1b1ab..39d81f8b4 100644
--- a/drivers/media/i2c/d4xx.c
+++ b/drivers/media/i2c/d4xx.c
@@ -5220,7 +5220,7 @@ static int ds5_chrdev_init(struct i2c_client *c, struct ds5 *state)
 		dev_dbg(&c->dev, "%s(): <Major, Minor>: <%d, %d>\n",
 				__func__, MAJOR(*dev_num), MINOR(*dev_num));
 		/* Create a class : appears at /sys/class */
-#if LINUX_VERSION_CODE < KERNEL_VERSION(6, 1, 0)
+#if LINUX_VERSION_CODE < KERNEL_VERSION(6, 2, 0)
 		*ds5_class = class_create(THIS_MODULE, DS5_DRIVER_NAME_CLASS);
 #else
 		*ds5_class = class_create(DS5_DRIVER_NAME_CLASS);
@@ -5853,7 +5853,13 @@ static struct i2c_driver ds5_i2c_driver = {
 		.owner = THIS_MODULE,
 		.name = DS5_DRIVER_NAME
 	},
+#if LINUX_VERSION_CODE < KERNEL_VERSION(6, 1, 0)
+        .probe          = ds5_probe,
+#elif LINUX_VERSION_CODE < KERNEL_VERSION(6, 6, 0)
+	.probe_new	= ds5_probe,
+#else
 	.probe		= ds5_probe,
+#endif
 	.remove		= ds5_remove,
 	.id_table	= ds5_id,
 };
diff --git a/drivers/media/i2c/max9295.c b/drivers/media/i2c/max9295.c
index d4bea2704..e0c06d1b8 100644
--- a/drivers/media/i2c/max9295.c
+++ b/drivers/media/i2c/max9295.c
@@ -660,8 +660,12 @@ int max9295_set_pipe(struct device *dev, int pipe_id,
 }
 EXPORT_SYMBOL(max9295_set_pipe);
 
+#if LINUX_VERSION_CODE < KERNEL_VERSION(6, 1, 0)
 static int max9295_probe(struct i2c_client *client,
 				const struct i2c_device_id *id)
+#else
+static int max9295_probe(struct i2c_client *client)
+#endif
 {
 	struct max9295 *priv;
 	struct max9295_pdata *pdata = client->dev.platform_data;
@@ -749,7 +753,13 @@ static struct i2c_driver max9295_i2c_driver = {
 		.name = "max9295",
 		.owner = THIS_MODULE,
 	},
+#if LINUX_VERSION_CODE < KERNEL_VERSION(6, 1, 0)
 	.probe = max9295_probe,
+#elif LINUX_VERSION_CODE < KERNEL_VERSION(6, 6, 0)
+	.probe_new = max9295_probe,
+#else
+	.probe = max9295_probe,
+#endif
 	.remove = max9295_remove,
 	.id_table = max9295_id,
 };
diff --git a/drivers/media/i2c/max9296.c b/drivers/media/i2c/max9296.c
index 8bd4ac040..42807262c 100644
--- a/drivers/media/i2c/max9296.c
+++ b/drivers/media/i2c/max9296.c
@@ -1082,8 +1082,12 @@ static struct regmap_config max9296_regmap_config = {
 	.cache_type = REGCACHE_RBTREE,
 };
 
+#if LINUX_VERSION_CODE < KERNEL_VERSION(6, 1, 0)
 static int max9296_probe(struct i2c_client *client,
 				const struct i2c_device_id *id)
+#else
+static int max9296_probe(struct i2c_client *client)
+#endif
 {
 	struct max9296 *priv;
 	int err = 0;
@@ -1161,7 +1165,13 @@ static struct i2c_driver max9296_i2c_driver = {
 		.owner = THIS_MODULE,
 		.of_match_table = of_match_ptr(max9296_of_match),
 	},
+#if LINUX_VERSION_CODE < KERNEL_VERSION(6, 1, 0)
 	.probe = max9296_probe,
+#elif LINUX_VERSION_CODE < KERNEL_VERSION(6, 6, 0)
+	.probe_new = max9296_probe,
+#else
+	.probe = max9296_probe,
+#endif
 	.remove = max9296_remove,
 	.id_table = max9296_id,
 };
-- 
2.25.1

