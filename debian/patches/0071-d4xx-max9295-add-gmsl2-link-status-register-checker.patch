+			(link_status & 0x40) ? "DRIFT_ERR " : "",
+			(link_status & 0x80) ? "PCLKDET " : "");
+	}
+
 	mutex_unlock(&priv->lock);
 
 	return err;
@@ -711,11 +902,11 @@ int max9295_set_mfp(struct device *dev, int pin, int val)
 	if (pin > 10)
 		return -EINVAL;
 
-	err = regmap_update_bits(map, 0x2BE + (pin * 3),
