+		max9295_read_reg(dev, MAX9295_LINK_STATUS_ADDR, &link_status);
+		dev_dbg(dev, "%s: Link status: 0x%02x (LOCK=%d, bit0-5: %s%s%s%s)\n",
+			__func__, link_status, !!(link_status & MAX9295_LINK_LOCK_BIT),
